{
  "name": "sandstone-work",
  "module": "scripts/setup.ts",
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@inquirer/prompts": "^8.2.0",
    "magic-string": "^1.1.0",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev:template": "bun run scripts/template.ts",
    "dev:minor": "bun run scripts/minor.ts",
    "dev:link": "bun run scripts/link.ts link",
    "dev:unlink": "bun run scripts/link.ts unlink",
    "dev:build:library": "cd sandstone && bun dev:build",
    "dev:build:template": "cd sandstone-template && bun dev:build",
    "release": "bun run scripts/release.ts",
    "template:cli-update": "bun run scripts/template-cli-update.ts"
  },
  "type": "module"
}
